{
  "main_course": "https://github.com/polar-byter/agent-harness-workshop-en/blob/main/",
  "documents": [
    {"path": "course/00-introduction.md"},
    {"path": "course/README.md"},
    {"path": "course/01-model-in-process.md"},
    {"path": "course/02-cat-journal.md"},
    {"path": "course/03-decisions.md"},
    {"path": "course/04-vision.md"},
    {"path": "course/05-movie-service.md"},
    {"path": "course/06-speech.md"},
    {"path": "course/07-telegram-bot.md"},
    {"path": "course/conclusion.md"}
  ],
  "requirements": {
    "llama": [
      "llama-cpp-python @ https://github.com/abetlen/llama-cpp-python/releases/download/v0.3.36/llama_cpp_python-0.3.36-py3-none-win_amd64.whl",
      "numpy==2.5.4",
      "diskcache==5.6.3",
      "Jinja2==3.1.6",
      "MarkupSafe==3.0.4",
      "typing_extensions==4.16.0"
    ],
    "excel": ["openpyxl==3.1.5"],
    "web": ["Flask==3.1.3"],
    "speech": ["pywhispercpp==1.5.1"],
    "telegram": ["pyTelegramBotAPI==4.37.1"]
  },
  "lessons": [
    {
      "number": 1, "root": "lesson-01-runtime", "path": "course/01-model-in-process.md",
      "title": "The model inside the program",
      "targets": [["local_llm.py", "ask"]], "models": ["chat"], "requirements": ["llama"],
      "own_runtime": true,
      "expected": "Offline check: You can return an item within 14 days."
    },
    {
      "number": 2, "root": "lesson-02-cat-journal", "path": "course/02-cat-journal.md",
      "title": "The cat's mischief journal",
      "targets": [["journal_ai.py", "classify_entry"]], "models": ["chat"], "requirements": ["llama", "excel"],
      "expected": "Offline check: Stole a meatball from the table while everyone was watching TV -> kitchen, severity 1"
    },
    {
      "number": 3, "root": "lesson-03-decisions", "path": "course/03-decisions.md",
      "title": "A model that makes decisions",
      "targets": [["decisions.py", "ask_choice"]], "models": ["chat"], "requirements": ["llama"],
      "expected": "Offline check: Charged twice for one order -> payment, confidence 0.97"
    },
    {
      "number": 4, "root": "lesson-04-vision", "path": "course/04-vision.md",
      "title": "A vision model checks the photo",
      "targets": [["photo_check.py", "check_photo"]], "models": ["vision", "vision-proj"], "requirements": ["llama"],
      "expected": "Offline check: to staff: damage is visible in the photo"
    },
    {
      "number": 5, "root": "lesson-05-movie-service", "path": "course/05-movie-service.md",
      "title": "The model in a web service",
      "targets": [["search.py", "SemanticSearch.find"], ["run.py", "main"]], "models": ["embed"],
      "requirements": ["llama", "web"],
      "expected": "Offline check: time travel -> Back to the Future"
    },
    {
      "number": 6, "root": "lesson-06-speech", "path": "course/06-speech.md",
      "title": "Transcribing a voice message",
      "targets": [["speech.py", "transcribe"]], "models": ["speech", "chat"], "requirements": ["llama", "speech"],
      "expected": "Offline check: [00:07] Two weeks ago I bought an electric kettle from you,"
    },
    {
      "number": 7, "root": "lesson-07-telegram-bot", "path": "course/07-telegram-bot.md",
      "title": "A Telegram bot on a local model",
      "targets": [["bot_logic.py", "handle_text"]], "models": ["chat"], "requirements": ["llama", "excel", "telegram"],
      "shared": {"journal_io.py": "lesson-02-cat-journal", "journal_ai.py": "lesson-02-cat-journal"},
      "expected": "Offline check: Recorded in the journal: kitchen, severity 1."
    }
  ]
}
